# quick virtual environment activation from current folder
alias venv="source /home/ss/dev/personal/dotfiles/bin/venv"
# play audio only
alias mpa="mpv --no-video --input-ipc-server=/tmp/mpvsocket"
alias mpb="mpv --no-video --input-ipc-server=/tmp/mpvsocket --ao=alsa --audio-device=alsa/bluealsa"
alias mpy="mpv --no-video --input-ipc-server=/tmp/mpvsocket --ao=alsa --audio-device=alsa/bluealsa ym://wave"
alias ls="eza"
alias cat="batcat"
alias icat="viu"
# my tool for viewing images, numpy arrays etc
alias lv="liveview"
